void byte_to_GPIO(uint8_t myByte) {
    // Бит 0
    if (myByte & 0b00000001) {
        gpio_set(LCDDB0);
    } else {
        gpio_clear(LCDDB0);
    }
    
    // Бит 1
    if (myByte & 0b00000010) {
        gpio_set(LCDDB1);
    } else {
        gpio_clear(LCDDB1);
    }
    
    // Бит 2
    if (myByte & 0b00000100) {
        gpio_set(LCDDB2);
    } else {
        gpio_clear(LCDDB2);
    }
    
    // Бит 3
    if (myByte & 0b00001000) {
        gpio_set(LCDDB3);
    } else {
        gpio_clear(LCDDB3);
    }
    
    // Бит 4
    if (myByte & 0b00010000) {
        gpio_set(LCDDB4);
    } else {
        gpio_clear(LCDDB4);
    }
    
    // Бит 5
    if (myByte & 0b00100000) {
        gpio_set(LCDDB5);
    } else {
        gpio_clear(LCDDB5);
    }
    
    // Бит 6
    if (myByte & 0b01000000) {
        gpio_set(LCDDB6);
    } else {
        gpio_clear(LCDDB6);
    }
    
    // Бит 7
    if (myByte & 0b10000000) {
        gpio_set(LCDDB7);
    } else {
        gpio_clear(LCDDB7);
    }
}

void LCDinit(void) {
    gpio_init(LCDA0, GPIO_OUT);
    gpio_init(LCDRW, GPIO_OUT);
    gpio_init(LCDE, GPIO_OUT);
    gpio_init(LCDDB0, GPIO_OUT);
    gpio_init(LCDDB1, GPIO_OUT);
    gpio_init(LCDDB2, GPIO_OUT);
    gpio_init(LCDDB3, GPIO_OUT);
    gpio_init(LCDDB4, GPIO_OUT);
    gpio_init(LCDDB5, GPIO_OUT);
    gpio_init(LCDDB6, GPIO_OUT);
    gpio_init(LCDDB7, GPIO_OUT);
    gpio_clear(LCDE);
	xtimer_msleep(30);
    gpio_clear(LCDRW);
    gpio_clear(LCDA0);
	byte_to_GPIO(0x30); 	
    xtimer_usleep(1);
    gpio_set(LCDE);
    xtimer_usleep(1);
	gpio_clear(LCDE);
	xtimer_usleep(40);	
	gpio_set(LCDE); 
	xtimer_usleep(1);
	gpio_clear(LCDE); 
	xtimer_usleep(40);
	gpio_set(LCDE);
	xtimer_usleep(1);
	gpio_clear(LCDE);
	xtimer_usleep(1);
	WriteCmd(0x38);		
	WriteCmd(0x0C);		
	WriteCmd(0x01);		
	WriteCmd(0x06);		
}

void WriteCmd(uint8_t b) { 
    WriteByte(b,0); 
}

void WriteData(uint8_t b) { 
    WriteByte(b,1); 
}

void WriteByte(uint8_t b, uint8_t cd) {
	gpio_set(LCDRW);
	gpio_clear(LCDA0);
	xtimer_usleep(1);
	gpio_set(LCDE); 
	xtimer_usleep(1);
    xtimer_msleep(30);
    gpio_clear(LCDE);
	xtimer_usleep(1);	
	gpio_clear(LCDRW); 
    if (cd & 0b00000001) {
        gpio_set(LCDA0);
    } else {
        gpio_clear(LCDA0);
    }
	byte_to_GPIO(b);
	xtimer_usleep(1);		
	gpio_set(LCDE); 
	xtimer_usleep(1);	
	gpio_clear(LCDE);
	xtimer_usleep(1);	
}

